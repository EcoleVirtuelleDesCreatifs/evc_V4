# ===================================
# CONFIGURATION CHARIOW
# ===================================

# Activer Chariow (désactive CinetPay automatiquement)
CHARIOW_ENABLED=true

# URLs de retour après paiement
CHARIOW_RETURN_URL="${APP_URL}/evc/payment/chariow/return"
CHARIOW_CANCEL_URL="${APP_URL}/evc/payment/chariow/cancel"
CHARIOW_WEBHOOK_URL="${APP_URL}/evc/payment/chariow/webhook"

# Mode de paiement
# direct_link : Redirection directe vers les liens Chariow (recommandé)
# api : Utilisation de l'API Chariow (si disponible dans le futur)
CHARIOW_MODE=direct_link

# ===================================
# Pour désactiver Chariow et utiliser CinetPay :
# ===================================
# CHARIOW_ENABLED=false

# ===================================
# NOTES :
# ===================================
# 1. Les liens de paiement sont configurés dans config/chariow.php
# 2. Créez d'abord vos produits/pages de checkout dans votre boutique Chariow
# 3. Mettez à jour les URLs dans config/chariow.php avec vos liens Chariow
