# Configuration MVP - École Virtuelle des Créatifs
# Copier ce fichier en .env pour activer le mode MVP

APP_NAME="EVC - École Virtuelle des Créatifs (MVP)"
APP_ENV=production
APP_KEY=base64:your-app-key-here
APP_DEBUG=false
APP_URL=http://localhost

# Mode MVP activé
MVP_MODE=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base de données
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=evc_database
DB_USERNAME=root
DB_PASSWORD=

# Cache et sessions
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail configuration (à configurer selon votre serveur)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@evc.ci"
MAIL_FROM_NAME="${APP_NAME}"

# Performance optimizations
CACHE_ENABLED=true
CACHE_DURATION=3600

# Limites MVP
MAX_UPLOAD_SIZE=2048
MAX_FILES_PER_TP=5
MAX_STUDENTS_PER_FORMATION=100

# Features flags (désactivées pour MVP)
FEATURE_ACTUALITES=false
FEATURE_EVENEMENTS=false
FEATURE_CVTHEQUE_COMPLETE=false
FEATURE_CERTIFICATS=false
FEATURE_STATISTIQUES_AVANCEES=false

# Notifications
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_IN_APP_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false

# UI/UX
SHOW_BETA_BADGE=true
THEME_SWITCHER=false
LANGUAGE_SWITCHER=false

# Monitoring
TRACK_ERRORS=true
SHOW_DEBUG_BAR=false
