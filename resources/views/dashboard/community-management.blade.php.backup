<style>
/* Thème Community Management - Dégradé Bleu Foncé et Orange Foncé */

/* Appliquer le dégradé bleu foncé-orange foncé sur tous les éléments primary */
.bg-primary {
    background: linear-gradient(135deg, #1e3c72 0%, #ff6f00 100%) !important;
}

.bg-primary.bg-opacity-10 {
    background: linear-gradient(135deg, rgba(30, 60, 114, 0.1) 0%, rgba(255, 111, 0, 0.1) 100%) !important;
}

.text-primary {
    background: linear-gradient(135deg, #1e3c72 0%, #ff6f00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* Badges avec dégradé */
.badge.bg-primary {
    background: linear-gradient(135deg, #1e3c72 0%, #ff6f00 100%) !important;
    border: none;
}

/* Boutons primary */
.btn-primary {
    background: linear-gradient(135deg, #1e3c72 0%, #ff6f00 100%) !important;
    border: none;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #2a5298 0%, #ff6f00 100%) !important;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(30, 60, 114, 0.4);
}

.btn-outline-primary {
    border-color: #1e3c72;
    color: #1e3c72;
}

.btn-outline-primary:hover {
    background: linear-gradient(135deg, #1e3c72 0%, #ff6f00 100%) !important;
    border-color: transparent;
    color: white;
    transform: translateY(-1px);
}

/* Progress bars */
.progress-bar {
    background: linear-gradient(90deg, #1e3c72 0%, #ff6f00 100%) !important;
}

/* Avatars */
.avatar {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.avatar-lg {
    width: 56px;
    height: 56px;
}

.avatar-sm {
    width: 32px;
    height: 32px;
}

/* Cards avec effets */
.card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(30, 60, 114, 0.2) !important;
}

/* Autres boutons */
.btn-outline-success:hover,
.btn-outline-warning:hover,
.btn-outline-info:hover,
.btn-outline-danger:hover,
.btn-outline-secondary:hover {
    transform: translateY(-1px);
}

.badge {
    font-size: 0.75rem;
}

/* Icônes avec couleur dégradée */
.fas.text-primary,
.fab.text-primary {
    background: linear-gradient(135deg, #1e3c72 0%, #ff6f00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* Liens avec couleur bleu foncé-orange foncé */
a.text-primary {
    background: linear-gradient(135deg, #1e3c72 0%, #ff6f00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

a.text-primary:hover {
    opacity: 0.8;
}
</style>
