    @php
        // Récupération des données utilisateur
        $student = $student ?? null;
        $user = auth()->user();
        
        // Photo de profil
        $photoUrl = asset('assets/img/avatar.png');
        if ($student && $student->profile_photo) {
            $photoUrl = asset('storage/' . $student->profile_photo);
        } elseif ($user && $user->profile_photo) {
            $photoUrl = asset('storage/' . $user->profile_photo);
        }
        
        // Informations personnelles
        $fullName = $student ? trim($student->first_name . ' ' . $student->last_name) : ($user->name ?? 'Étudiant');
        $email = $student->email ?? $user->email ?? '';
        $phone = $student->phone ?? '';
        $whatsapp = $student->whatsapp ?? '';
        $city = $student->city ?? '';
        $country = $student->country ?? 'Côte d\'Ivoire';
        $quartier = $student->quartier ?? '';
        
        // Calcul de l'âge
        $age = 0;
        if ($student && $student->date_of_birth) {
            $birthDate = new DateTime($student->date_of_birth);
            $today = new DateTime();
            $age = $today->diff($birthDate)->y;
        }
        
        // Statistiques
        $formationsCount = 12; // À remplacer par les vraies données
        $tpRendus = 0;
        $tpTotal = 0;
        $projetsRealises = 0;
        $projetsTotal = 0;
        $evenementsCount = 4;
        $prochainEvenement = 5; // jours
        
        // Progression du profil
        $profileCompletion = 85;
