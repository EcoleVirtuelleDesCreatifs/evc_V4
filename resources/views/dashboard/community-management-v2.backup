    /* Dashboard Cards */
    .dashboard-card {
        border-radius: 15px;
        padding: 1.5rem;
        color: white;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        min-height: 120px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .dashboard-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .dashboard-card::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .dashboard-card:hover::before {
        opacity: 1;
    }

    .dashboard-card-icon {
        font-size: 2.5rem;
        opacity: 0.9;
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
    }

    .card-formations {
        background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
    }

    .card-tp {
        background: linear-gradient(135deg, #e91e63 0%, #c2185b 100%);
    }

    .card-projets {
        background: linear-gradient(135deg, #00bcd4 0%, #0097a7 100%);
    }

    .card-evenements {
        background: linear-gradient(135deg, #4caf50 0%, #388e3c 100%);
    }

    /* Info Cards */
    .info-card {
        background: white;
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        margin-bottom: 1rem;
    }

    .info-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        margin-right: 1rem;
    }

    /* Tabs */
    .custom-tabs {
        border-bottom: 2px solid #e0e0e0;
        margin-bottom: 2rem;
    }

    .custom-tab {
        padding: 1rem 1.5rem;
        border: none;
        background: none;
        color: #666;
        font-weight: 500;
        position: relative;
        cursor: pointer;
        transition: color 0.3s ease;
    }

    .custom-tab.active {
        color: #ff9800;
    }

    .custom-tab.active::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        right: 0;
        height: 2px;
        background: #ff9800;
    }

    /* Welcome Alert */
    .welcome-alert {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        border-left: 4px solid #2196f3;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
    }

    /* Progress Bar */
    .profile-progress {
        background: #e0e0e0;
        height: 8px;
        border-radius: 10px;
        overflow: hidden;
        margin-top: 0.5rem;
    }

    .profile-progress-bar {
        background: linear-gradient(90deg, #4caf50 0%, #8bc34a 100%);
        height: 100%;
        transition: width 0.3s ease;
    }

    /* Action Cards */
    .action-card {
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        display: block;
        color: inherit;
    }

    .action-card:hover {
        border-color: #2196f3;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(33, 150, 243, 0.2);
        text-decoration: none;
        color: inherit;
    }

    .action-card-icon {
